# Datenbank: lokal SQLite, in Produktion Supabase-Pooler-URL
# z.B. postgresql://postgres.<ref>:<passwort>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./invoices.db
UPLOAD_DIR=./uploads
# Kommagetrennte CORS-Origins (Netlify-Domain + lokale Entwicklung)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://doku-agent.netlify.app
