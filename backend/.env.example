# Datenbank: lokal SQLite, in Produktion Supabase-Pooler-URL
# z.B. postgresql://postgres.<ref>:<passwort>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./invoices.db
UPLOAD_DIR=./uploads
# Kommagetrennte CORS-Origins (Netlify-Domain + lokale Entwicklung)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://rechnung-doku.netlify.app

# JWT-Secret für Login/Benutzerverwaltung (in Produktion zwingend setzen!)
JWT_SECRET=bitte-langes-zufaelliges-geheimnis-setzen
# JWT_EXPIRE_MINUTES=10080

# Optional: ersten Admin beim Start anlegen, falls noch keine Benutzer existieren
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=sicheres-passwort
# BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator

# Supabase Storage (optional): PDFs werden dann nicht mehr lokal, sondern in
# einem privaten Supabase-Bucket abgelegt (empfohlen fuer Render, da dessen
# Dateisystem ephemer ist). Ohne diese beiden Werte bleibt der lokale Fallback
# (UPLOAD_DIR) aktiv.
# SUPABASE_URL=https://<projekt-ref>.supabase.co
# SUPABASE_SERVICE_KEY=eyJ... (Project Settings -> API -> service_role secret)
# SUPABASE_STORAGE_BUCKET=invoices

# Gemini Flash fuer Scan-PDFs ohne Textschicht (Hybrid-Extraktion).
# API-Key aus https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-3.6-flash
